{
  "name": "price-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "bun run typecheck && bun run scripts/lint.ts",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run '**/*.integration.test.ts'",
    "test:watch": "vitest",
    "migrate": "PGSSLMODE=require db-migrate up --config ./database.json --env dev",
    "migrate:create": "db-migrate create --config ./database.json --sql-file --env dev",
    "migrate:down": "PGSSLMODE=require db-migrate down --config ./database.json --env dev",
    "warmup": "bun run scripts/warmup-prices.ts",
    "backfill:token-address-checksums": "bun run scripts/backfill-token-address-checksums.ts",
    "daily:enqueue-file": "bun run scripts/enqueue-daily-price-targets.ts",
    "daily:run": "bun run scripts/run-daily-price-worker.ts",
    "daily:status": "bun run scripts/daily-price-status.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "0.10.4",
    "dotenv": "16.6.1",
    "viem": "2.47.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260329.1",
    "@types/node": "22.19.15",
    "db-migrate": "0.11.14",
    "db-migrate-pg": "1.5.2",
    "pg": "8.20.0",
    "typescript": "5.9.3",
    "vitest": "4.1.5",
    "wrangler": "4.78.0"
  }
}
