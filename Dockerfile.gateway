FROM oven/bun:1.4.4-slim

ARG PRICE_GATEWAY_REVISION=development
ENV PRICE_GATEWAY_REVISION=$PRICE_GATEWAY_REVISION

WORKDIR /app

# Keep the runtime image limited to the gateway and its direct, dependency-free
# source modules. Provider credentials and proxy lists arrive only at runtime
# through the Cloudflare Container envVars binding.
COPY gateway/package.json ./package.json
COPY scripts/provider-gateway.ts ./scripts/provider-gateway.ts
COPY src/clients/http-client.ts ./src/clients/http-client.ts
COPY src/clients/provider-transport.ts ./src/clients/provider-transport.ts
COPY src/clients/proxy-pool.ts ./src/clients/proxy-pool.ts
COPY src/http/errors.ts ./src/http/errors.ts
COPY src/types.ts ./src/types.ts

ENV PRICE_GATEWAY_PORT=8788
ENV PRICE_GATEWAY_BIND=0.0.0.0

EXPOSE 8788

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["bun", "-e", "fetch('http://127.0.0.1:8788/healthz').then((response) => { if (!response.ok) process.exit(1) }).catch(() => process.exit(1))"]

USER bun

CMD ["bun", "run", "scripts/provider-gateway.ts"]

