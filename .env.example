DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Local docker (`bun run db:up`):
# DATABASE_URL=postgres://postgres:postgres@db.localtest.me:54329/price_service
API_KEY_KONG=replace-me
API_KEY_FRONTEND=replace-me
ENSO_API_KEY=replace-me
# Optional historical ypriceAPI source (both credentials are required).
YPRICEAPI_SIGNER=
YPRICEAPI_SIGNATURE=
YPRICEAPI_URL=https://ypriceapi-beta.yearn.finance
# Optional ordered archive RPC backups. The singular RPC_URL remains first.
# RPC_URLS_1=["https://archive-primary.example","https://archive-backup.example"]
# Bun jobs: rotate HTTP(S) CONNECT proxies after 429/502/503/504 or network failures.
# Lists contain proxy URLs or host:port entries; keep credentials in secrets.
PRICE_PROXY_URLS=
PRICE_PROXY_LIST_URLS=
# Opt in to downloading public proxy candidates from Proxifly on GitHub.
PRICE_PROXY_PUBLIC_LIST=false
# Cloudflare Workers use the authenticated Bun gateway for proxy support.
# Deploy gateway/wrangler.toml through the optional CI job (see README),
# or run scripts/provider-gateway.ts behind HTTPS; set these on the Worker.
PRICE_GATEWAY_URL=
PRICE_GATEWAY_TOKEN=
# Standalone gateway defaults: localhost:8788. Container config binds 0.0.0.0.
# PRICE_GATEWAY_BIND=127.0.0.1
# PRICE_GATEWAY_PORT=8788
RPC_URL_1=https://example-rpc
RPC_URL_10=https://example-rpc
RPC_URL_100=https://example-rpc
RPC_URL_137=https://example-rpc
RPC_URL_146=https://example-rpc
RPC_URL_250=https://example-rpc
RPC_URL_8453=https://example-rpc
RPC_URL_42161=https://example-rpc
RPC_URL_80094=https://example-rpc
RPC_URL_747474=https://example-rpc
RPC_URL_4663=https://rpc.mainnet.chain.robinhood.com
RPC_URL_999=https://example-rpc
# Weekly audit heartbeat (CI only; the script does not read it).
UPTIME_URL=
# Sentry error reporting; unset disables it.
SENTRY_DSN=
